{
  "info": {
    "name": "Template API integration tests",
    "description": "Smoke tests replayed by newman in CI (MAIR-117). `baseUrl` is injected by docker-compose-integration.yml; the default in environment.json targets a local stack. The API only holds Core's public key (MAIR-680): integration_test.sh signs EdDSA JWTs with the run's key pair (test_secrets.sh) for the seeded Admin (user 1) and a plain user (user 2, seeded by init-test.sql), plus a forged and an expired one, and passes them with --env-var (the Postman sandbox cannot sign EdDSA); the pre-request script only forges the HS256 token that must be refused. The template has no business endpoint: this collection covers the service probes, the OpenAPI document and the JWT gate. A new API keeps these folders and adds its own scenario (see the sibling APIs for the pattern).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// MAIR-680: the API only holds Core's public key. The EdDSA tokens (jwt_admin, jwt_agent,",
          "// jwt_forged, jwt_expired...) are signed by integration_test.sh with the run's key and passed with",
          "// --env-var (the Postman sandbox cannot sign EdDSA). This script only forges jwt_hs256: an HS256",
          "// token for the Admin signed with a random secret, which the API must refuse whatever the secret.",
          "const cryptoJs = require('crypto-js');",
          "const b64url = (words) => cryptoJs.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const header = b64url(cryptoJs.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "const exp = Math.floor(Date.now() / 1000) + 3600;",
          "const payload = b64url(cryptoJs.enc.Utf8.parse(JSON.stringify({ sub: String(pm.environment.get('admin_user_id') || '1'), role: 'admin', exp })));",
          "const secret = cryptoJs.lib.WordArray.random(32);",
          "pm.environment.set('jwt_hs256', `${header}.${payload}.${b64url(cryptoJs.HmacSHA256(`${header}.${payload}`, secret))}`);",
          "",
          "// OpenAPI contract (MAIR-262), identical in every API collection: the spec served by the API",
          "// under test is loaded once per run, every response is then checked against it (collection test",
          "// script) and the last request fails when an operation or a documented status was never tested.",
          "if (!pm.collectionVariables.get('openapi_spec')) {",
          "    pm.sendRequest(`${pm.environment.get('baseUrl')}/api-docs/openapi.json`, (err, res) => {",
          "        if (err || res.code !== 200) {",
          "            throw new Error(`OpenAPI spec unavailable (${err || res.code}): the stack must set SWAGGER_ENABLED=true`);",
          "        }",
          "        pm.collectionVariables.set('openapi_spec', res.text());",
          "        pm.collectionVariables.set('openapi_covered', '[]');",
          "    });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// OpenAPI contract (MAIR-262), identical in every API collection: the answer of every request",
          "// must be documented by the spec of the API under test (operation, status, content type, body",
          "// schema), and the (operation, status) pair is recorded for the coverage check of the last request.",
          "const openapi = {",
          "    spec: () => JSON.parse(pm.collectionVariables.get('openapi_spec')),",
          "    // The operation of `method path`, literal segments winning over path parameters",
          "    // (`/formations/catalog/` before `/formations/{formation_id}/`).",
          "    find: (spec, method, path) => {",
          "        const candidates = Object.keys(spec.paths)",
          "            .filter((template) => spec.paths[template][method])",
          "            .filter((template) => new RegExp(`^${template.replace(/[.*+?^$()|[\\]\\\\]/g, '\\\\$&').replace(/\\{[^}]+\\}/g, '[^/]+')}$`).test(path))",
          "            .sort((a, b) => (a.match(/\\{/g) || []).length - (b.match(/\\{/g) || []).length);",
          "        return candidates.length ? { template: candidates[0], operation: spec.paths[candidates[0]][method] } : null;",
          "    },",
          "    // JSON schema keywords the validator understands; `$ref`s are inlined, the rest (`format`,",
          "    // `example`, `description`...) is dropped so unknown formats such as `int64` never fail.",
          "    clean: (spec, schema, depth = 0) => {",
          "        if (!schema || typeof schema !== 'object' || depth > 32) return {};",
          "        if (schema.$ref) {",
          "            return openapi.clean(spec, schema.$ref.split('/').slice(1).reduce((node, key) => node[key], spec), depth + 1);",
          "        }",
          "        const out = {};",
          "        ['type', 'required', 'enum', 'const', 'minimum', 'maximum', 'minLength', 'maxLength', 'pattern', 'minItems', 'maxItems']",
          "            .filter((key) => key in schema).forEach((key) => { out[key] = schema[key]; });",
          "        if (schema.properties) {",
          "            out.properties = {};",
          "            Object.keys(schema.properties).forEach((key) => { out.properties[key] = openapi.clean(spec, schema.properties[key], depth + 1); });",
          "        }",
          "        if (schema.items) out.items = openapi.clean(spec, schema.items, depth + 1);",
          "        if (typeof schema.additionalProperties === 'object') out.additionalProperties = openapi.clean(spec, schema.additionalProperties, depth + 1);",
          "        ['oneOf', 'anyOf', 'allOf'].filter((key) => schema[key]).forEach((key) => { out[key] = schema[key].map((s) => openapi.clean(spec, s, depth + 1)); });",
          "        return out;",
          "    },",
          "    record: (key) => {",
          "        const covered = JSON.parse(pm.collectionVariables.get('openapi_covered') || '[]');",
          "        if (!covered.includes(key)) covered.push(key);",
          "        pm.collectionVariables.set('openapi_covered', JSON.stringify(covered));",
          "    },",
          "    // Checks one answer against the spec and records the (operation, status) pair.",
          "    check: (spec, method, path, code, contentType, text) => {",
          "        const found = openapi.find(spec, method, path);",
          "        pm.test(`Contract: ${method.toUpperCase()} ${path} is a documented operation`, () => {",
          "            pm.expect(found, 'operation in the OpenAPI spec').to.be.an('object');",
          "        });",
          "        if (!found) return;",
          "        // A response may be a `$ref` to `#/components/responses/...`: follow it before reading its content.",
          "        const documented = found.operation.responses[String(code)];",
          "        const response = documented && documented.$ref",
          "            ? documented.$ref.split('/').slice(1).reduce((node, key) => node[key], spec)",
          "            : documented;",
          "        pm.test(`Contract: ${code} is documented for ${method.toUpperCase()} ${found.template}`, () => {",
          "            pm.expect(Object.keys(found.operation.responses)).to.include(String(code));",
          "        });",
          "        if (!response) return;",
          "        openapi.record(`${method.toUpperCase()} ${found.template} ${code}`);",
          "        // Media types are case-insensitive (RFC 9110): both sides are compared lowercased.",
          "        const media = Object.keys(response.content || {}).map((type) => type.toLowerCase());",
          "        if (!media.length) {",
          "            pm.test(`Contract: ${code} of ${method.toUpperCase()} ${found.template} has no body`, () => {",
          "                pm.expect(text, 'the spec documents no content').to.be.empty;",
          "            });",
          "            return;",
          "        }",
          "        // The media type without its parameters (`; charset=utf-8`), compared whole so that",
          "        // `application/jsonp` is not taken for `application/json`.",
          "        const answered = (contentType || '').split(';')[0].trim().toLowerCase();",
          "        pm.test(`Contract: ${code} answers ${media.join(' or ')}`, () => {",
          "            pm.expect(media, `content-type ${contentType}`).to.include(answered);",
          "        });",
          "        const jsonEntry = Object.entries(response.content).find(([type]) => type.toLowerCase() === 'application/json');",
          "        const json = jsonEntry && jsonEntry[1];",
          "        if (json && json.schema && answered === 'application/json') {",
          "            pm.test(`Contract: ${code} body matches the schema of ${method.toUpperCase()} ${found.template}`, () => {",
          "                const schema = openapi.clean(spec, json.schema);",
          "                const errors = [];",
          "                const validate = (value, s, at) => {",
          "                    const matches = (o) => { const before = errors.length; validate(value, o, at); const ok = errors.length === before; errors.length = before; return ok; };",
          "                    if (s.oneOf && s.oneOf.filter(matches).length !== 1) errors.push(`${at}: does not match exactly one oneOf`);",
          "                    if (s.anyOf && !s.anyOf.some(matches)) errors.push(`${at}: matches no anyOf`);",
          "                    if (s.allOf) s.allOf.forEach((o) => validate(value, o, at));",
          "                    const types = s.type === undefined ? null : [].concat(s.type);",
          "                    const typeOf = value === null ? 'null' : Array.isArray(value) ? 'array' : typeof value === 'number' && Number.isInteger(value) ? 'integer' : typeof value;",
          "                    if (types && !types.includes(typeOf) && !(typeOf === 'integer' && types.includes('number'))) { errors.push(`${at}: ${typeOf} instead of ${types.join('|')}`); return; }",
          "                    if (s.enum && !s.enum.some((e) => JSON.stringify(e) === JSON.stringify(value))) errors.push(`${at}: ${JSON.stringify(value)} not in ${JSON.stringify(s.enum)}`);",
          "                    if (s.const !== undefined && JSON.stringify(s.const) !== JSON.stringify(value)) errors.push(`${at}: not ${JSON.stringify(s.const)}`);",
          "                    if (typeof value === 'number') {",
          "                        if (s.minimum !== undefined && value < s.minimum) errors.push(`${at}: ${value} < ${s.minimum}`);",
          "                        if (s.maximum !== undefined && value > s.maximum) errors.push(`${at}: ${value} > ${s.maximum}`);",
          "                    }",
          "                    if (typeof value === 'string') {",
          "                        if (s.minLength !== undefined && value.length < s.minLength) errors.push(`${at}: shorter than ${s.minLength}`);",
          "                        if (s.maxLength !== undefined && value.length > s.maxLength) errors.push(`${at}: longer than ${s.maxLength}`);",
          "                        if (s.pattern && !new RegExp(s.pattern, 'u').test(value)) errors.push(`${at}: does not match ${s.pattern}`);",
          "                    }",
          "                    if (Array.isArray(value)) {",
          "                        if (s.minItems !== undefined && value.length < s.minItems) errors.push(`${at}: fewer than ${s.minItems} items`);",
          "                        if (s.maxItems !== undefined && value.length > s.maxItems) errors.push(`${at}: more than ${s.maxItems} items`);",
          "                        if (s.items) value.forEach((v, i) => validate(v, s.items, `${at}[${i}]`));",
          "                    }",
          "                    if (typeOf === 'object') {",
          "                        (s.required || []).filter((key) => !(key in value)).forEach((key) => errors.push(`${at}.${key}: required`));",
          "                        Object.keys(value).forEach((key) => {",
          "                            if (s.properties && s.properties[key]) validate(value[key], s.properties[key], `${at}.${key}`);",
          "                            else if (s.additionalProperties) validate(value[key], s.additionalProperties, `${at}.${key}`);",
          "                        });",
          "                    }",
          "                };",
          "                validate(JSON.parse(text), schema, '$');",
          "                pm.expect(errors, errors.join('\\n')).to.be.empty;",
          "            });",
          "        }",
          "    },",
          "};",
          "// A request may opt out with `pm.variables.set('openapi_contract', 'skip')` in its pre-request",
          "// script, saying why (API_template checks its JWT gate on an undocumented scope).",
          "if (pm.collectionVariables.get('openapi_spec') && !pm.request.url.getPath().startsWith('/api-docs')",
          "    && pm.variables.get('openapi_contract') !== 'skip') {",
          "    openapi.check(",
          "        openapi.spec(),",
          "        pm.request.method.toLowerCase(),",
          "        pm.variables.replaceIn(pm.request.url.getPath()),",
          "        pm.response.code,",
          "        pm.response.headers.get('Content-Type'),",
          "        pm.response.text(),",
          "    );",
          "}"
        ]
      }
    }
  ],
