    {
      "name": "Every secured operation refuses a missing JWT",
      "item": [
        {
          "name": "Every secured operation refuses a missing JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Every operation declaring `security((\"jwt\" = []))` answers 401 text/plain without a token",
                  "// (MAIR-262): a new secured endpoint is covered as soon as it is documented. Path parameters take",
                  "// the spec's example, or 1; the guard answers before the handler reads the path or the body.",
                  "const spec = JSON.parse(pm.collectionVariables.get('openapi_spec'));",
                  "const covered = JSON.parse(pm.collectionVariables.get('openapi_covered') || '[]');",
                  "const operations = [];",
                  "Object.keys(spec.paths).forEach((template) => {",
                  "    Object.keys(spec.paths[template]).filter((method) => ['get', 'put', 'post', 'delete', 'options', 'head', 'patch', 'trace'].includes(method)).forEach((method) => {",
                  "        const operation = spec.paths[template][method];",
                  "        if (!(operation.security || spec.security || []).some((requirement) => 'jwt' in requirement)) return;",
                  "        const params = {};",
                  "        (operation.parameters || []).filter((p) => p.in === 'path').forEach((p) => { params[p.name] = p.example !== undefined ? p.example : 1; });",
                  "        const path = template.replace(/\\{([^}]+)\\}/g, (_, name) => encodeURIComponent(params[name] !== undefined ? params[name] : 1));",
                  "        operations.push({ method: method.toUpperCase(), template, path, documented: Object.keys(operation.responses) });",
                  "    });",
                  "});",
                  "let pending = operations.length;",
                  "if (pending === 0) console.log('The spec declares no jwt-secured operation.');",
                  "operations.forEach((op) => {",
                  "    pm.sendRequest({",
                  "        url: `${pm.environment.get('baseUrl')}${op.path}`,",
                  "        method: op.method,",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: ['POST', 'PUT', 'PATCH'].includes(op.method) ? { mode: 'raw', raw: '{}' } : undefined,",
                  "    }, (err, res) => {",
                  "        pm.test(`${op.method} ${op.template} without JWT answers a documented 401 text/plain`, () => {",
                  "            pm.expect(err).to.not.be.ok;",
                  "            pm.expect(res.code).to.eql(401);",
                  "            pm.expect(op.documented).to.include('401');",
                  "            pm.expect((res.headers.get('Content-Type') || '').split(';')[0].trim().toLowerCase()).to.eql('text/plain');",
                  "        });",
                  "        if (!err && res.code === 401) covered.push(`${op.method} ${op.template} 401`);",
                  "        pending -= 1;",
                  "        if (pending === 0) pm.collectionVariables.set('openapi_covered', JSON.stringify([...new Set(covered)]));",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Replays every jwt-secured operation of the served spec without a token and expects 401."
          }
        }
      ]
    },
