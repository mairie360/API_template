{
  "info": {
    "name": "Template API integration tests",
    "description": "Smoke tests replayed by newman in CI (MAIR-117). `baseUrl` is injected by docker-compose-integration.yml; the default in environment.json targets a local stack. The API only holds Core's public key (MAIR-680): integration_test.sh signs EdDSA JWTs with the run's key pair (test_secrets.sh) for the seeded Admin (user 1) and a plain user (user 2, seeded by init-test.sql), plus a forged and an expired one, and passes them with --env-var (the Postman sandbox cannot sign EdDSA); the pre-request script only forges the HS256 token that must be refused. The template has no business endpoint: this collection covers the service probes, the OpenAPI document and the JWT gate. A new API keeps these folders and adds its own scenario (see the sibling APIs for the pattern).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// MAIR-680: the API only holds Core's public key. The EdDSA tokens (jwt_admin, jwt_agent,",
          "// jwt_forged, jwt_expired...) are signed by integration_test.sh with the run's key and passed with",
          "// --env-var (the Postman sandbox cannot sign EdDSA). This script only forges jwt_hs256: an HS256",
          "// token for the Admin signed with a random secret, which the API must refuse whatever the secret.",
          "const cryptoJs = require('crypto-js');",
          "const b64url = (words) => cryptoJs.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const header = b64url(cryptoJs.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "const exp = Math.floor(Date.now() / 1000) + 3600;",
          "const payload = b64url(cryptoJs.enc.Utf8.parse(JSON.stringify({ sub: String(pm.environment.get('admin_user_id') || '1'), role: 'admin', exp })));",
          "const secret = cryptoJs.lib.WordArray.random(32);",
          "pm.environment.set('jwt_hs256', `${header}.${payload}.${b64url(cryptoJs.HmacSHA256(`${header}.${payload}`, secret))}`);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Service",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Body matches the expected text\", function () {",
                  "    pm.expect(pm.response.text()).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200: Postgres and Redis answer\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Body matches the expected text\", function () {",
                  "    pm.expect(pm.response.text()).to.eql(\"ready\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "OpenAPI document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api-docs/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api-docs",
                "openapi.json"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Document is an OpenAPI spec\", function () {",
                  "    const doc = pm.response.json();",
                  "    pm.expect(doc.openapi).to.be.a(\"string\");",
                  "    pm.expect(doc.paths).to.be.an(\"object\");",
                  "    pm.expect(Object.keys(doc.paths)).to.include(\"/health\");",
                  "    pm.expect(Object.keys(doc.paths)).to.include(\"/ready\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Protected scope without JWT is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "MAIR-680 EdDSA JWT signed with another key under Core's kid is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_forged}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Expired JWT is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_expired}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "MAIR-680 HS256 JWT is rejected without JWT_SECRET",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_hs256}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Error answer is plain text and does not echo the token\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.not.include('html');",
                  "    pm.expect(pm.response.text()).to.not.include(pm.environment.get('jwt_hs256'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "MAIR-680 Valid JWT passes the gate (EdDSA, Core's key)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_admin}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Nothing is mounted under /api/v1 in the template\", function () {",
                  "    // 404 rather than 401: the JWT was accepted, the template just has no route there yet.",
                  "    pm.expect(pm.response.code).to.not.eql(401);",
                  "});",
                  "pm.test(\"The token is an EdDSA token under Core's kid (MAIR-680)\", function () {",
                  "    const header = JSON.parse(atob(pm.environment.get('jwt_admin').split('.')[0].replace(/-/g, '+').replace(/_/g, '/')));",
                  "    pm.expect(header.alg).to.eql('EdDSA');",
                  "    pm.expect(header.kid).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Valid JWT of the seeded plain user passes the gate",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_agent}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
