    },
    {
      "name": "OpenAPI coverage",
      "item": [
        {
          "name": "OpenAPI coverage",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// OpenAPI coverage (MAIR-262), last request of the collection: every documented operation has",
                  "// at least one success case, and each documented 400/401/403/404/409/412 has a case of its own.",
                  "// 429, 500, 502 and 503 cannot be produced on purpose on a healthy stack: the handler tests",
                  "// (`cargo test`) cover them. Any other gap is listed in the collection variable",
                  "// `openapi_coverage_exceptions` ({ \"METHOD /template STATUS\": \"reason\" }, `2xx` for the success",
                  "// case); an exception that is covered or no longer documented fails too, so it never goes stale.",
                  "const spec = JSON.parse(pm.collectionVariables.get('openapi_spec'));",
                  "const covered = JSON.parse(pm.collectionVariables.get('openapi_covered') || '[]');",
                  "const exceptions = JSON.parse(pm.collectionVariables.get('openapi_coverage_exceptions') || '{}');",
                  "const required = [];",
                  "Object.keys(spec.paths).forEach((template) => {",
                  "    Object.keys(spec.paths[template]).filter((method) => ['get', 'put', 'post', 'delete', 'options', 'head', 'patch', 'trace'].includes(method)).forEach((method) => {",
                  "        const op = `${method.toUpperCase()} ${template}`;",
                  "        const statuses = Object.keys(spec.paths[template][method].responses);",
                  "        // A success case (2xx, or the 3xx of a redirect such as Core's `GET /admin-access`) is required",
                  "        // even when the spec documents none: the gap then shows here. Its key stays `2xx`.",
                  "        required.push({ key: `${op} 2xx`, covered: statuses.some((s) => /^[23]/.test(s) && covered.includes(`${op} ${s}`)) });",
                  "        statuses.filter((s) => ['400', '401', '403', '404', '409', '412'].includes(s))",
                  "            .forEach((s) => required.push({ key: `${op} ${s}`, covered: covered.includes(`${op} ${s}`) }));",
                  "    });",
                  "});",
                  "const missing = required.filter((r) => !r.covered && !(r.key in exceptions)).map((r) => r.key);",
                  "const stale = Object.keys(exceptions).filter((key) => !required.some((r) => r.key === key && !r.covered));",
                  "pm.test(`Every documented operation and status is tested (${covered.length} covered)`, () => {",
                  "    pm.expect(missing, `not tested:\\n${missing.join('\\n')}`).to.be.empty;",
                  "});",
                  "pm.test('Every coverage exception is still needed', () => {",
                  "    pm.expect(stale, `stale exceptions:\\n${stale.join('\\n')}`).to.be.empty;",
                  "});",
                  "// End of the run: drop the spec and the recorded pairs, so that a next run in the Postman app (which",
                  "// keeps collection variables between runs) loads the spec of the image it tests and starts with an",
                  "// empty coverage instead of counting the answers of this one.",
                  "pm.collectionVariables.unset('openapi_spec');",
                  "pm.collectionVariables.unset('openapi_covered');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Fails when a documented operation or status was never tested by this collection."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "openapi_spec",
      "value": "",
      "type": "string"
    },
    {
      "key": "openapi_covered",
      "value": "[]",
      "type": "string"
    },
    {
      "key": "openapi_coverage_exceptions",
      "value": "{}",
      "type": "string"
    }
  ]
